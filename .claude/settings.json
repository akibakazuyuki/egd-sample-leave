{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.egd/bin/egd.py\" guard"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(.egd/config.json)",
      "Edit(.egd/project.yaml)",
      "Edit(.egd/bin/**)",
      "Edit(.github/workflows/egd-verify.yml)",
      "Edit(AGENTS.md)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)"
    ]
  }
}
